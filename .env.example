# Copiez ce fichier en .env.local et remplissez les valeurs (jamais commité sur Git)

# Base de données Postgres (Neon, gratuit) — Vercel → Storage → Create Database → Neon Postgres
# copie la valeur "DATABASE_URL" (ou "POSTGRES_URL") fournie par Neon/Vercel
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Chaîne aléatoire longue, utilisée pour signer les sessions (compte client + admin)
# Générez-en une avec : openssl rand -hex 32
SESSION_SECRET="change-moi-en-une-chaine-aleatoire-longue"

# Mot de passe pour accéder à /admin (choisissez-en un fort, gardez-le secret)
ADMIN_PASSWORD="change-moi"
